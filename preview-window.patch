+static void _preview_monitor_added(GdkDisplay *display, GdkMonitor *monitor, gpointer user_data)
+{
+  dt_preview_window_t *preview = (dt_preview_window_t *)user_data;
+  _preview_schedule_monitor_update(preview);
+}
+
