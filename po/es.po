#: ../src/libs/export.c:1187 ../src/libs/print_settings.c:2301
#: ../src/libs/print_settings.c:2626
msgctxt "rendering intent"
msgid "saturation"
msgstr "saturación"

#: ../src/libs/export.c:1188 ../src/libs/print_settings.c:2302
#: ../src/libs/print_settings.c:2627
msgid "absolute colorimetric"
msgstr "colorimétrico absoluto"

#: ../src/libs/export.c:1191
#, c-format
msgid ""
"• perceptual: smoothly moves out-of-gamut colors into gamut,preserving "
"gradations, but distorts in-gamut colors in the process. note that "
"perceptual is often a proprietary LUT that depends on the destination "
"space.\n"
"\n"
"• relative colorimetric: keeps luminance while reducing as little as "
"possible saturation until colors fit in gamut.\n"
"\n"
"• saturation: designed to present eye-catching business graphics by "
"preserving the saturation. (not suited for photography).\n"
"\n"
"• absolute colorimetric: adapt white point of the image to the white point "
"of the destination medium and do nothing else. mainly used when proofing "
"colors. (not suited for photography)."
msgstr ""
"• Perceptivo: Ajusta los colores fuera de gama hacia la gama con "
"transiciones suaves. Preserva las gradaciones, pero se modifican todos los "
"colores (incluidos los colores en gama). Tenga en cuenta que el modo "
"perceptivo es a menudo un LUT propietario que depende del espacio de "
"destino.\n"
"\n"
"• Colorimétrico relativo: Mantiene la luminancia mientras que reduce la "
"saturación hasta que los colores entren en la gama.\n"
"\n"
"• Saturación: Diseñado para presentar gráficos llamativos preservando la "
"saturación. (No destinado para la fotografía).\n"
"\n"
"• Colorimétrico absoluto: Lo único que hace es cambiar el punto blanco de la "
"imagen al punto blanco del medio de destino. Se utiliza principalmente para "
"hacer pruebas de colores. (No apto para la fotografía)."

