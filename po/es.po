#: ../src/iop/filmic.c:352
msgid "11 EV (dim outdoors)"
msgstr "11 EV (atenuación en exteriores)"

#: ../src/iop/filmic.c:360
msgid "12 EV (outdoors)"
msgstr "12 EV (exteriores)"

#: ../src/iop/filmic.c:368
msgid "13 EV (bright outdoors)"
msgstr "13 EV (exteriores luminosos)"

#: ../src/iop/filmic.c:376
msgid "14 EV (backlighting)"
msgstr "14 EV (retroiluminación)"

#: ../src/iop/filmic.c:384
msgid "15 EV (sunset)"
msgstr "15 EV (puesta de sol)"

#: ../src/iop/filmic.c:392
msgid "16 EV (HDR)"
msgstr "16 EV (HDR)"

#: ../src/iop/filmic.c:400
msgid "18 EV (HDR++)"
msgstr "18 EV (HDR++)"

#: ../src/iop/filmic.c:1475
msgid "read-only graph, use the parameters below to set the nodes"
msgstr ""
"Gráfico de solo lectura, utilice los siguientes parámetros para configurar "
"los nodos"

#: ../src/iop/filmic.c:1482
msgid "logarithmic shaper"
msgstr "modelador logarítmico"

#: ../src/iop/filmic.c:1490
msgid ""
"adjust to match the average luminance of the subject.\n"
"except in back-lighting situations, this should be around 18%."
msgstr ""
"Ajústelo para que coincida con la luminancia promedio del sujeto. \n"
"Excepto en situaciones de retroiluminación, esto debería ser alrededor del "
"18%."

#: ../src/iop/filmic.c:1501 ../src/iop/filmicrgb.c:5467
msgid ""
"number of stops between middle gray and pure white.\n"
"this is a reading a lightmeter would give you on the scene.\n"
"adjust so highlights clipping is avoided"
msgstr ""
"Número de pasos entre el gris medio y el blanco puro.\n"
"Es la lectura que un exposímetro mostraría en la escena.\n"
"Ajustarlo para evitar el recorte de luces."

#: ../src/iop/filmic.c:1513 ../src/iop/filmicrgb.c:5477
msgid ""
"number of stops between middle gray and pure black.\n"
"this is a reading a lightmeter would give you on the scene.\n"
"increase to get more contrast.\n"
"decrease to recover more details in low-lights."
msgstr ""
"Número de pasos entre el gris medio y el negro puro.\n"
"Es la lectura que un exposímetro mostraría en la escena.\n"
"Aumentar para obtener más contraste.\n"
"Disminuir para recuperar más detalles en condiciones de poca luz."

#: ../src/iop/filmic.c:1524
msgid ""
"enlarge or shrink the computed dynamic range.\n"
"useful in conjunction with \"auto tune levels\"."
msgstr ""
"Aumentar o reducir el rango dinámico calculado.\n"
"Útil en combinación con \"niveles automáticos\"."

#: ../src/iop/filmic.c:1530 ../src/iop/filmicrgb.c:5490
#: ../src/iop/profile_gamma.c:586
msgid "auto tune levels"
msgstr "niveles automáticos"

#: ../src/iop/filmic.c:1532
msgid ""
"try to optimize the settings with some guessing.\n"
"this will fit the luminance range inside the histogram bounds.\n"
"works better for landscapes and evenly-lit pictures\n"
"but fails for high-keys and low-keys."
msgstr ""
"Trata de optimizar los ajustes con algunas estimaciones.\n"
"Esto ajustará el rango de luminancia dentro de los límites del histograma.\n"
"Funciona mejor para paisajes y fotos uniformemente iluminadas\n"
"pero falla en las clave alta y clave baja."

#: ../src/iop/filmic.c:1537
msgid "filmic S curve"
msgstr "curva S de película"

#: ../src/iop/filmic.c:1544 ../src/iop/filmicrgb.c:5615
msgid ""
"slope of the linear part of the curve\n"
"affects mostly the mid-tones"
msgstr ""
"Pendiente de la parte lineal de la curva\n"
"Afecta sobre todo a los tonos medios"

#. geotagging
#: ../src/iop/filmic.c:1551 ../src/libs/metadata_view.c:207
msgid "latitude"
msgstr "latitud"

#: ../src/iop/filmic.c:1554
msgid ""
"width of the linear domain in the middle of the curve.\n"
"increase to get more contrast at the extreme luminances.\n"
"this has no effect on mid-tones."
msgstr ""
"Anchura del dominio lineal en el centro de la curva.\n"
"Para obtener más contraste en las luminancias extremas.\n"
"No tiene efecto en los tonos medios."

#: ../src/iop/filmic.c:1561
msgid "shadows/highlights balance"
msgstr "equilibrio entre sombras y luces"

#: ../src/iop/filmic.c:1564
msgid ""
"slides the latitude along the slope\n"
"to give more room to shadows or highlights.\n"
"use it if you need to protect the details\n"
"at one extremity of the histogram."
msgstr ""
"Desliza la latitud a lo largo de la pendiente \n"
"para dar más espacio a las sombras o luces.\n"
"Usarlo en caso de querer proteger los detalles \n"
"en un extremo del histograma."

#: ../src/iop/filmic.c:1574
msgid ""
"desaturates the input of the module globally.\n"
"you need to set this value below 100%\n"
"if the chrominance preservation is enabled."
msgstr ""
"Desatura la entrada del módulo a nivel general. \n"
"Es necesario establecer este valor por debajo del 100% \n"
"si la preservación de la crominancia está habilitada."

#: ../src/iop/filmic.c:1584
msgid ""
"desaturates the output of the module\n"
"specifically at extreme luminances.\n"
"decrease if shadows and/or highlights are over-saturated."
msgstr ""
"Desatura la salida del módulo\n"
"específicamente a luminancias extremas.\n"
"Disminuir si las sombras o las luces o ambas están sobresaturadas."

#: ../src/iop/filmic.c:1594 ../src/libs/export.c:1183
#: ../src/libs/print_settings.c:2298 ../src/libs/print_settings.c:2621
msgid "intent"
msgstr "propósito"

#: ../src/iop/filmic.c:1595
msgid "contrasted"
msgstr "contrastado"

#. cubic spline
#: ../src/iop/filmic.c:1596
msgid "faded"
msgstr "difuminado"

#. monotonic spline
#: ../src/iop/filmic.c:1598
msgid "optimized"
msgstr "optimizado"

#: ../src/iop/filmic.c:1600
msgid "change this method if you see reversed contrast or faded blacks"
msgstr ""
"Cambiar el método si aparecen contrastes invertidos o negros difuminados"

#. Preserve color
#: ../src/iop/filmic.c:1604
msgid "preserve the chrominance"
msgstr "preservar la crominancia"

#: ../src/iop/filmic.c:1606
msgid ""
"ensure the original color are preserved.\n"
"may reinforce chromatic aberrations.\n"
"you need to manually tune the saturation when using this mode."
msgstr ""
"Garantiza la conservación del color original. \n"
"Puede acentuar las aberraciones cromáticas. \n"
"Es necesario ajustar manualmente la saturación cuando se utiliza este modo."

#: ../src/iop/filmic.c:1616
msgid "destination/display"
msgstr "destino/visualización"

#: ../src/iop/filmic.c:1634 ../src/iop/filmicrgb.c:5715
msgid ""
"luminance of output pure black, this should be 0%\n"
"except if you want a faded look"
msgstr ""
"La luminancia de salida negro puro, debería ser del 0%\n"
"excepto si se desea lograr un aspecto difuminado"

#: ../src/iop/filmic.c:1643 ../src/iop/filmicrgb.c:5722
msgid ""
"middle gray value of the target display or color space.\n"
"you should never touch that unless you know what you are doing."
msgstr ""
"Valor gris medio de la pantalla de destino o espacio de color.\n"
"Evitar modificarlo (a no ser que se sepa lo que se está haciendo)."

#: ../src/iop/filmic.c:1652 ../src/iop/filmicrgb.c:5729
msgid ""
"luminance of output pure white, this should be 100%\n"
"except if you want a faded look"
msgstr ""
"La luminancia de salida blanco puro debería ser del 100%\n"
"excepto si se desea lograr un aspecto difuminado"

#: ../src/iop/filmic.c:1658
msgid "target gamma"
msgstr "gamma destino"

#: ../src/iop/filmic.c:1660
msgid ""
"power or gamma of the transfer function\n"
"of the display or color space.\n"
"you should never touch that unless you know what you are doing."
msgstr ""
"Potencia o gamma de la función de transferencia\n"
"de la pantalla o del espacio de color.\n"
"Evitar moverlo a menos que se sepa lo que se está haciendo."

#: ../src/iop/filmicrgb.c:424
#, fuzzy
msgid "fil_mic"
msgstr "curva S de película"

#: ../src/iop/filmicrgb.c:429
msgid "tone mapping|curve|view transform|contrast|saturation|highlights"
msgstr "mapeo de tonos|curva|cambiar aspecto|contraste|saturación|luces"

#: ../src/iop/filmicrgb.c:434
msgid ""
"apply a view transform to prepare the scene-referred pipeline\n"
"for display on SDR screens and paper prints\n"
"while preventing clipping in non-destructive ways"
msgstr ""
"Efectúa una transformación visual mediante una curva de tono personalizable\n"
"imitando la reproducción del rango tonal de la película evitando\n"
"recortes en sombras y luces, para mostrarse en pantallas con Rango Dinámico "
"Estándar (SDR) o para impresión"

#: ../src/iop/filmicrgb.c:4483
msgid "look only"
msgstr "vista general"

#: ../src/iop/filmicrgb.c:4485
msgid "look + mapping (lin)"
msgstr "vista + mapeo (lin)"

#: ../src/iop/filmicrgb.c:4487
msgid "look + mapping (log)"
msgstr "vista + mapeo (log)"

#: ../src/iop/filmicrgb.c:4489
msgid "dynamic range mapping"
msgstr "mapeo del rango dinámico"

#: ../src/iop/filmicrgb.c:4856
#, c-format
msgid "(%.0f %%)"
msgstr "(%.0f %%)"

#: ../src/iop/filmicrgb.c:4872
#, no-c-format
msgid "% display"
msgstr "% de visualización"

#: ../src/iop/filmicrgb.c:4884
msgid "EV scene"
msgstr "EV de escena "

#: ../src/iop/filmicrgb.c:4888
#, no-c-format
msgid "% camera"
msgstr "% en cámara"

#. Page DISPLAY
#: ../src/iop/filmicrgb.c:4924 ../src/iop/filmicrgb.c:5709
msgid "display"
msgstr "pantalla"

#. axis legend
#: ../src/iop/filmicrgb.c:4933
msgid "(%)"
msgstr "(%)"

#. Page SCENE
#: ../src/iop/filmicrgb.c:4942 ../src/iop/filmicrgb.c:5450
msgid "scene"
msgstr "escena"

#. axis legend
#: ../src/iop/filmicrgb.c:4951
msgid "(EV)"
msgstr "(EV)"

#. we are over the graph area
#: ../src/iop/filmicrgb.c:5380
msgid ""
"use the parameters below to set the nodes.\n"
"the bright curve is the filmic tone mapping curve\n"
"the dark curve is the desaturation curve."
msgstr ""
"Configure los parámetros de los nodos mediante los controles debajo.\n"
"La curva clara corresponde al mapeo de tono de película.\n"
"La curva oscura corresponde a la saturación."

#: ../src/iop/filmicrgb.c:5386
msgid "toggle axis labels and values display"
msgstr "Mostrar los valores y etiquetas en los ejes"

#: ../src/iop/filmicrgb.c:5390
msgid ""
"cycle through graph views.\n"
"left click: cycle forward.\n"
"right click: cycle backward.\n"
"double-click: reset to look view."
msgstr ""
"Cambiar vista de gráfica.\n"
"Clic primario: hacia adelante.\n"
"Clic secundario: hacia atrás.\n"
"Pulsación doble: restablece la vista."

#: ../src/iop/filmicrgb.c:5457
msgid ""
"adjust to match the average luminance of the image's subject.\n"
"the value entered here will then be remapped to 18.45%.\n"
"decrease the value to increase the overall brightness."
msgstr ""
"Ajústelo para que coincida con la luminosidad promedio del sujeto de la "
"imagen.\n"
"El valor aquí ingresado se reajustará para corresponder al 18.45%.\n"
"Disminuya el valor para aumentar el brillo general."

#: ../src/iop/filmicrgb.c:5485
msgid ""
"symmetrically enlarge or shrink the computed dynamic range.\n"
"useful to give a safety margin to extreme luminances."
msgstr ""
"Ampliar o reducir simétricamente el rango dinámico calculado.\n"
"Es útil para dar margen de seguridad a las luminancias extremas."

#: ../src/iop/filmicrgb.c:5494
msgid ""
"try to optimize the settings with some statistical assumptions.\n"
"this will fit the luminance range inside the histogram bounds.\n"
"works better for landscapes and evenly-lit pictures\n"
"but fails for high-keys, low-keys and high-ISO pictures.\n"
"this is not an artificial intelligence, but a simple guess.\n"
"ensure you understand its assumptions before using it."
msgstr ""
"Busca optimizar los ajustes con algunas estimaciones estadísticas.\n"
"Se ajustará al rango de luminancia dentro de los límites del histograma.\n"
"Funciona mejor en paisajes y fotos uniformemente iluminadas\n"
"pero es falible con la clave alta, la clave baja e ISO alto.\n"
"La estimación es simplemente un cálculo y no inteligencia artificial,\n"
"por lo que es importante comprender esas estimaciones antes de usarlo."

#: ../src/iop/filmicrgb.c:5502 ../src/iop/filmicrgb.c:5583
#: ../src/iop/filmicrgb.c:5680
msgid "advanced"
msgstr "avanzado"

#: ../src/iop/filmicrgb.c:5506
#, c-format
msgid ""
"enable to input custom middle-gray values.\n"
"this is not recommended in general.\n"
"fix the global exposure in the exposure module instead.\n"
"disable to use standard 18.45 %% middle gray."
msgstr ""
"Para poder introducir valores personalizados para el gris medio\n"
"(normalmente no recomendado), habilite esta opción.\n"
"Alternativamente, se puede fijar la exposición general en el módulo de "
"exposición.\n"
"Deshabilite para usar el gris medio estándar a 18.45%%."

#. Page RECONSTRUCT -- deprecated (issue #1084); kept for edits that already use it, hidden for the
#. rest by _filmic_update_hl_deprecation()
#: ../src/iop/filmicrgb.c:5513
msgid "reconstruct"
msgstr "reconstruir"

#: ../src/iop/filmicrgb.c:5516
msgid "highlights clipping"
msgstr "recorte de luces"

#: ../src/iop/filmicrgb.c:5522
msgid ""
"set the exposure threshold upon which\n"
"clipped highlights get reconstructed.\n"
"values are relative to the scene white point.\n"
"0 EV means the threshold is the same as the scene white point.\n"
"decrease to include more areas,\n"
"increase to exclude more areas."
msgstr ""
"Fija el umbral superior\n"
"Fijar el umbral de exposición a partir del cual\n"
"las luces recortadas se reconstruyen.\n"
"Los valores están en relación al punto blanco de la escena.\n"
"0 EV significa que el umbral es el mismo que el punto blanco de la escena.\n"
"Disminuir para abarcar un área mayor.\n"
"Aumentar para excluir un área mayor."

#: ../src/iop/filmicrgb.c:5532
msgid ""
"soften the transition between clipped highlights and valid pixels.\n"
"decrease to make the transition harder and sharper,\n"
"increase to make the transition softer and blurrier."
msgstr ""
"Suaviza la transición entre los pixeles válidos y las luces recortadas.\n"
"Disminuir para hacer la transición más drástica y nítida.\n"
"Aumentar para hacer la transición más suave y difuminada."

#: ../src/iop/filmicrgb.c:5538 ../src/iop/filmicrgb.c:5539
msgid "display highlight reconstruction mask"
msgstr "mostrar la máscara de reconstrucción de luces"

#: ../src/iop/filmicrgb.c:5546 ../src/iop/splittoning.c:502
msgid "balance"
msgstr "balance"

#: ../src/iop/filmicrgb.c:5553
#, no-c-format
msgid ""
"decide which reconstruction strategy to favor,\n"
"between inpainting a smooth color gradient,\n"
"or trying to recover the textured details.\n"
"0% is an equal mix of both.\n"
"increase if at least one RGB channel is not clipped.\n"
"decrease if all RGB channels are clipped over large areas."
msgstr ""
"Determina cuál estrategia de reconstrucción potenciar:\n"
"restaurando con un suave gradiente de color\n"
"o tratando de recuperar la textura en los detalles.\n"
"El 0% es una mezcla de ambos por igual.\n"
"Aumentar si al menos un canal RGB no está recortado.\n"
"Disminuir si todos los canales RGB están recortados en áreas amplias."

#: ../src/iop/filmicrgb.c:5564
#, no-c-format
msgid ""
"decide which reconstruction strategy to favor,\n"
"between blooming highlights like film does,\n"
"or trying to recover sharp details.\n"
"0% is an equal mix of both.\n"
"increase if you want more details.\n"
"decrease if you want more blur."
msgstr ""
"Determina qué estrategia de reconstrucción potenciar:\n"
"aumentando el resplandor en las luces como en el cine\n"
"o tratando de recuperar la nitidez en los detalles.\n"
"El 0% es una mezcla de ambos por igual.\n"
"Aumentar para obtener más detalles.\n"
"Disminuir para obtener más difuminado."

#: ../src/iop/filmicrgb.c:5576
#, no-c-format
msgid ""
"decide which reconstruction strategy to favor,\n"
"between recovering monochromatic highlights,\n"
"or trying to recover colorful highlights.\n"
"0% is an equal mix of both.\n"
"increase if you want more color.\n"
"decrease if you see magenta or out-of-gamut highlights."
msgstr ""
"Determina cuál estrategia de reconstrucción potenciar:\n"
"recuperando de las luces monocromáticas\n"
"o tratando de recuperar luces coloridas.\n"
"El 0% es una mezcla de ambos por igual.\n"
"Aumentar para obtener más color.\n"
"Disminuir si en las luces aparece un tono magenta o fuera de gama."

#: ../src/iop/filmicrgb.c:5589
msgid ""
"run extra passes of chromaticity reconstruction.\n"
"more iterations means more color propagation from neighbourhood.\n"
"this will be slower but will yield more neutral highlights.\n"
"it also helps with difficult cases of magenta highlights."
msgstr ""
"Ejecuta pasadas adicionales de reconstrucción de cromaticidad.\n"
"Con más iteraciones se hace una propagación mayor del color desde la "
"localidad,\n"
"haciéndose más lento a favor de producir más luces neutras.\n"
"También contribuye en corregir la ocurrencia de luces magentas difíciles."

#: ../src/iop/filmicrgb.c:5596
msgid ""
"add statistical noise in reconstructed highlights.\n"
"this avoids highlights to look too smooth\n"
"when the picture is noisy overall,\n"
"so they blend with the rest of the picture."
msgstr ""
"Añade ruido aleatorio en las luces reconstruidas.\n"
"Cuando la imagen tiene ruido homogéneamente,\n"
"las luces pueden verse muy suavizadas.\n"
"El ruido añadido hará que se mezclen con el resto de la imagen,"

#: ../src/iop/filmicrgb.c:5603
msgid ""
"choose the statistical distribution of noise.\n"
"this is useful to match natural sensor noise pattern.\n"
msgstr ""
"Elija una distribución de probabilidad para el ruido.\n"
"Es útil para hacerlo coincidir con el patrón natural del ruido del sensor.\n"

#. Page LOOK
#: ../src/iop/filmicrgb.c:5607
msgid "look"
msgstr "apariencia"

#: ../src/iop/filmicrgb.c:5609 ../src/iop/tonemap.cc:100
msgid "tone mapping"
msgstr "mapeo de tonos"

#: ../src/iop/filmicrgb.c:5620
msgid ""
"equivalent to paper grade in analog.\n"
"increase to make highlights brighter and less compressed.\n"
"decrease to mute highlights."
msgstr ""
"Equivalente al gramaje de papel en físico.\n"
"Aumentar para que las luces sean más brillantes y con menor compresión.\n"
"Disminuir para apagar las luces."

#: ../src/iop/filmicrgb.c:5634
msgid ""
"distance between middle gray and the start of the highlights roll-off.\n"
"0% keeps the shoulder at middle gray, 100% pushes it to the point where the\n"
"current slope would hit the output white level."
msgstr ""

#: ../src/iop/filmicrgb.c:5645
msgid ""
"distance between middle gray and the start of the shadows roll-off.\n"
"0% keeps the toe at middle gray, 100% pushes it to the point where the\n"
"current slope would hit the output black level."
msgstr ""

#: ../src/iop/filmicrgb.c:5652
msgid ""
"shape of the highlights roll-off of the curve.\n"
"perceptual (default) is a generalized sigmoid derived from a\n"
"perceptual appearance model: always smooth and monotonic.\n"
"hard/soft/safe are the legacy polynomial/rational segments;\n"
"hard compresses highlights more, soft less."
msgstr ""

#: ../src/iop/filmicrgb.c:5659
msgid ""
"shape of the shadows roll-off of the curve.\n"
"perceptual (default) is a generalized sigmoid derived from a\n"
"perceptual appearance model: always smooth and monotonic.\n"
"hard/soft/safe are the legacy polynomial/rational segments;\n"
"hard compresses shadows more, soft less."
msgstr ""

#: ../src/iop/filmicrgb.c:5671 ../src/iop/filmicrgb.c:5806
msgid ""
"desaturates the output of the module\n"
"specifically at extreme luminances.\n"
"increase if shadows and/or highlights are under-saturated."
msgstr ""
"Desatura la imagen resultante del módulo,\n"
"específicamente en luminancias extremas.\n"
"Aumentar si las sombras o las luces les falta saturación."

#: ../src/iop/filmicrgb.c:5676
msgid ""
"ensure the original color are preserved.\n"
"may reinforce chromatic aberrations and chroma noise,\n"
"so ensure they are properly corrected elsewhere.\n"
msgstr ""
"Busca preservar el color original. \n"
"Puede acentuar el ruido de croma y las aberraciones cromáticas, \n"
"por lo que se recomienda corregir mediante otros módulos.\n"

#: ../src/iop/filmicrgb.c:5686
msgid ""
"v3 is darktable 3.0 desaturation method, same as color balance.\n"
"v4 is a newer desaturation method, based on spectral purity of light.\n"
"v8 tone maps each RGB channel separately in an inset rendering space:\n"
"highlights bleach toward white and hues drift as tonal compression\n"
"increases, with a parametric hue recovery on the saturation slider."
msgstr ""

#: ../src/iop/filmicrgb.c:5696
msgid ""
"how the latitude, balance and contrast place the toe and\n"
"shoulder nodes of the curve (not the shape between them —\n"
"that is 'contrast in shadows/highlights').\n"
"v3 (2021) is recommended; v1/v2 are kept for older edits."
msgstr ""

#: ../src/iop/filmicrgb.c:5704
msgid ""
"enable to auto-set the look hardness depending on the scene white and black "
"points.\n"
"this keeps the middle gray on the identity line and improves fast tuning.\n"
"disable if you want a manual control."
msgstr ""
"Ajusta la dureza automáticamente en función de los puntos blanco y negro de "
"la escena.\n"
"Esto mantiene idéntico el gris medio y mejora los ajustes rápidos.\n"
"Si se desea ajustar manualmente, desactive."

#: ../src/iop/filmicrgb.c:5793
#, fuzzy
msgid "color preservation"
msgstr "reconstrucción de color"

#: ../src/iop/filmicrgb.c:5794
#, c-format
msgid ""
"how much of the per-channel hue drift to keep.\n"
"saturation is not affected: valid diffuse colors\n"
"(skin tones, product colors) keep their saturation and\n"
"strongly compressed colors bleach, at any setting.\n"
"-100%% is pure AgX: full hue drift (the 'film' look).\n"
"0%% (default) removes half the hue drift.\n"
"+100%% restores the original hues exactly."
msgstr ""

#: ../src/iop/filmicrgb.c:5812
msgid "mid-tones saturation"
msgstr "saturación en los tonos medios"

#: ../src/iop/filmicrgb.c:5813
msgid ""
"desaturates the output of the module\n"
"specifically at medium luminances.\n"
"increase if midtones are under-saturated."
msgstr ""
"Desatura la imagen resultante del módulo,\n"
"específicamente en luminancias medias.\n"
"Aumentar si a los tonos medios les falta saturación."

#: ../src/iop/filmicrgb.c:5819
#, fuzzy
msgid "highlights saturation mix"
msgstr "incremento en las luces"

#: ../src/iop/filmicrgb.c:5820
msgid ""
"Positive values ensure saturation is kept unchanged over the whole range.\n"
"Negative values bleache highlights at constant hue and luminance.\n"
"Zero is an equal mix of both strategies."
msgstr ""
"Los valores positivos garantizan que la saturación se mantenga invariable en "
"toda la gama.\n"
"Los valores negativos blanquean las altas luces con un tono y una luminancia "
"constantes.\n"
"Cero es una mezcla a partes iguales de ambas estrategias."

#: ../src/iop/finalscale.c:55
msgctxt "modulename"
msgid "Final resampling"
msgstr "Remuestreo de alta calidad"

#: ../src/iop/finalscale.c:224
