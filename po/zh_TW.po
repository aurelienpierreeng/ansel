#: ../src/iop/denoiseprofile.c:3714
msgid "non-local means"
msgstr "非局部平均值（進階手動）"

#: ../src/iop/denoiseprofile.c:3715
msgid "non-local means auto"
msgstr "非局部平均值（精簡自動）"

#: ../src/iop/denoiseprofile.c:3716
msgid "wavelets"
msgstr "小波變換（進階手動）"

#: ../src/iop/denoiseprofile.c:3717
