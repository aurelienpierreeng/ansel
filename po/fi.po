msgstr "[lmmse_mosaiikin palautus] liian pieni alue."

#: ../src/iop/demosaic/rcd.c:290
msgid "[rcd_demosaic] too small area"
msgstr "[rcd_mosaiikin palautus] liian pieni alue."

