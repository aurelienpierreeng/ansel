msgstr "去边"

#. 4. chromatic aberrations, and the coefficients the manual source uses
#: ../src/iop/defringe.c:99 ../src/iop/lens.c:3725
msgid "chromatic aberrations"
msgstr "色差"

#: ../src/iop/defringe.c:104
