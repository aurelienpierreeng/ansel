msgstr "[lmmse_demosaic] area troppo piccola"

#: ../src/iop/demosaic/rcd.c:290
msgid "[rcd_demosaic] too small area"
msgstr "[rcd_demosaic] area troppo piccola"

#: ../src/iop/denoiseprofile.c:756
msgid "wavelets: chroma only"
msgstr "Wavelets: solo cromaticità"

#: ../src/iop/denoiseprofile.c:762
msgid "de_noise (profiled)"
msgstr "Riduzione rumore (profilato)"

#: ../src/iop/denoiseprofile.c:768
msgid "denoise using noise statistics profiled on sensors"
msgstr ""
"Riduzione del rumore con l'utilizzo delle statistiche relative al rumore "
"tipico del sensore"

