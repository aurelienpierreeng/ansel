msgstr "fil_mic"

#: ../src/iop/filmicrgb.c:429
msgid "tone mapping|curve|view transform|contrast|saturation|highlights"
msgstr "Mappatura tonale|curve|trasforma vista|contrasto|saturazione|alte-luci"

