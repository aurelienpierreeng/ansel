msgstr "Raggio del passaggio di sfocatura"

#: ../src/iop/dither.c:696
msgid "the gradient range where to apply random dither"
msgstr "La gamma del gradiente a cui applicare il dithering casuale"

#: ../src/iop/dither.c:697
